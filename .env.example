# voip backend: /api/web/login, /api/users
NEXT_PUBLIC_VOIP_API_URL=https://voip.totus.club
# kedam_API: /api/admin/*, /user/orders, /orders, /client/orders
NEXT_PUBLIC_API_BASE_URL=https://api.totus.club

# Заголовки безопасности (next.config.js, аудит 2026-11 H8).
# CSP: report-only (по умолчанию, только отчёт в консоль) | enforce (блокировка) | off.
CSP_MODE=report-only
# Дополнительные источники для CSP через запятую (виджеты, внешние API).
# CSP_EXTRA_SOURCES=
